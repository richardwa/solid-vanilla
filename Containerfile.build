# Build recipe for solid-vanilla, driven by the build daemon:
#   podman build -f Containerfile.build -t solidvanilla/solid-vanilla:<branch>-<hash> .
#   podman run --rm -e OUTPUT=/output -v <rundir>:/output solidvanilla/solid-vanilla:...
#
# Artifact shape under $OUTPUT (one publish-ready tarball per workspace
# package, produced by `bun pm pack`):
#   solid-vanilla-0.1.0.tgz        — the reactive framework
#   solid-vanilla-ui-0.1.0.tgz     — reusable components on top of the framework
#                                    (depends on solid-vanilla)
#   solid-vanilla-server-0.1.0.tgz — Express-based API helper (deps: express,
#                                    yaml)
#
# The build stage is setup (deps + sources); the run stage is the gate:
# `bun run build` (tsup bundle + tsc typecheck for every package) and
# `bun run test` (bun test, core). It then packs each package's dist/ into its
# tarball, exactly what `bun publish` would ship.
FROM docker.io/oven/bun:1.3.13-alpine

WORKDIR /src

# pre-install to warm bun's cache so this layer caches across source changes.
# Note this CANNOT be the real install: with the package dirs still empty,
# bun's per-package node_modules (where the .bin links live) are not created.
# The run stage therefore re-runs bun install with the full tree (fast,
# everything comes from the cache).
COPY package.json bun.lock ./
COPY solid-vanilla-core/package.json solid-vanilla-core/
COPY solid-vanilla-ui/package.json solid-vanilla-ui/
COPY solid-vanilla-server/package.json solid-vanilla-server/
COPY solid-vanilla-starter/package.json solid-vanilla-starter/
RUN bun install --frozen-lockfile || true

COPY . .

# Run stage:
# 1. real install with the full tree, so bun creates the per-package
#    node_modules (with the .bin links tsc/prettier need). The deps layer's
#    premature install left empty node_modules dirs that make bun skip
#    linking, so remove them first (the cache stays warm, so this is fast).
# 2. gate: tsup bundle + tsc typecheck (bun run build) and bun test (core).
# 3. pack each package from its own dir, so the tarball is the exact artifact
#    `bun publish` would ship (bun pm pack also resolves workspace:* deps).
CMD set -e; \
    : "${OUTPUT:?OUTPUT must be set to the artifact output dir}"; \
    rm -rf node_modules solid-vanilla-*/node_modules; \
    bun install --frozen-lockfile; \
    bun run build; \
    bun run test; \
    (cd solid-vanilla-core   && bun pm pack --destination "$OUTPUT"); \
    (cd solid-vanilla-ui     && bun pm pack --destination "$OUTPUT"); \
    (cd solid-vanilla-server && bun pm pack --destination "$OUTPUT")
