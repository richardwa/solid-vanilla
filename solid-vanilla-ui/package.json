{
  "name": "solid-vanilla-ui",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "format": "bun x prettier -w *.json ./src",
    "prebuild": "bun run format",
    "dev": "tsup --watch",
    "build": "tsup && tsc"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "tsup": "^9.0.0",
    "typescript": "7"
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "solid-vanilla": "workspace:*"
  }
}
