{
  "name": "solid-vanilla-server",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "format": "bun x prettier -w *.json ./src",
    "prebuild": "bun run format",
    "dev": "tsup --watch",
    "build": "tsup && tsc"
  },
  "dependencies": {
    "express": "^5.2.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/express": "types/express",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.6",
    "tsup": "^9.0.0",
    "typescript": "7"
  }
}
