{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext", // Supports modern Node module resolution
    "moduleResolution": "bundler",
    "declaration": true, // Generates .d.ts files
    "emitDeclarationOnly": true,
    "declarationMap": true, // Map files back to source code for easy debugging
    "sourceMap": true, // Generates source maps
    "outDir": "./dist", // Output compilation folder
    "rootDir": "./src", // Input source folder
    "strict": true, // Enables strict type-checking
    "esModuleInterop": true, // Smooths interoperability with older modules
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/__tests__/*", "**/*.test.ts"]
}
